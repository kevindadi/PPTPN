digraph SimplePetriNet {
  // 库所
  P1 [shape=circle, label="token=1;capacity=1"];
  P2 [shape=circle, label="token=0;capacity=1"];
  P3 [shape=circle, label="token=0;capacity=1"];
  
  // 变迁
  T1 [shape=box, label="time=[1,3];priority=99;core=1"];
  T2 [shape=box, label="time=[2,4];priority=88;core=1"];
  
  // 边
  P1 -> T1 [xlabel="weight=1"];
  T1 -> P2 [xlabel="weight=1"];
  P2 -> T2 [xlabel="weight=1"];
  T2 -> P3 [xlabel="weight=1"];
} 