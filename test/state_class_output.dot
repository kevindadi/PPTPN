digraph StateClassGraph {
  rankdir=LR;
  fontname="SimSun";
  node [fontname="SimSun", shape=box];
  edge [fontname="SimSun"];

  S0 [label="S0\nmarkings: {P1->1}\n使能变迁: T1[[0, 0]]\n"];
  S1 [label="S1\nmarkings: {P2->1}\n使能变迁: T2[[0, 0]]\n"];
  S2 [label="S2\nmarkings: {P3->1}\n"];
  S0 -> S1 [label="T1\n[1, 3]"];
  S1 -> S2 [label="T2\n[2, 4]"];
}
