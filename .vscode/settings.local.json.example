{
  // 复制为 settings.local.json 以覆盖个人路径(该文件已被 gitignore)
  //
  // macOS Homebrew 安装 vcpkg 示例:
  // "cmake.environment": {
  //   "VCPKG_ROOT": "/Users/you/vcpkg"
  // },
  //
  // macOS Homebrew clangd 示例:
  // "clangd.path": "/opt/homebrew/opt/llvm/bin/clangd",
  //
  // Linux 自定义 vcpkg 路径示例:
  // "cmake.environment": {
  //   "VCPKG_ROOT": "/home/you/vcpkg"
  // }
}
