{
  // CMake：vcpkg 路径由 CMakeLists.txt 自动探测（~/vcpkg 或 $VCPKG_ROOT）
  "cmake.configureSettings": {
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
  },
  "cmake.environment": {
    "VCPKG_ROOT": "${env:VCPKG_ROOT}"
  },
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": false,

  // 使用 clangd 提供 C++ 语言服务，关闭 Microsoft C/C++ 扩展的 IntelliSense 避免冲突
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  // clangd 从 PATH 查找，Linux/macOS 通用；query-driver 覆盖常见编译器安装路径
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never",
    "--query-driver=/usr/bin/c++,/usr/bin/g++,/usr/bin/*,/usr/local/bin/*,/opt/homebrew/bin/*"
  ],

  // 个人覆盖（如 macOS 上 vcpkg 不在默认位置）请写入 settings.local.json（已 gitignore）
  "files.exclude": {
    "**/.git": true
  }
}
