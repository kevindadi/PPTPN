{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure",
      "type": "shell",
      "command": "cmake -B build -G Ninja -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "linux": {
        "command": "cmake -B build -G Ninja -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_CXX_COMPILER=g++ -DCMAKE_C_COMPILER=gcc"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "VCPKG_ROOT": "${env:VCPKG_ROOT}"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake --build build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "ctest --test-dir build --output-on-failure",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
