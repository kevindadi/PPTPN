{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ptpn (tdg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ptpn",
      "args": ["tdg", "-f", "example/common/input.json"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "cmake: build",
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb"
      }
    },
    {
      "name": "Debug ptpn (ptpn)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/ptpn",
      "args": ["ptpn", "-f", "example/common/simple.ptpn"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "cmake: build",
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "osx": {
        "MIMode": "lldb"
      }
    }
  ]
}
