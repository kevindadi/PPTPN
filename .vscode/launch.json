    "version": "0.2.0",
    "configurations": [
        {
            "name": "run time",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/PTPN",
            "args": [
                "cpus",
                "6",
                "cores",
                "1",
                "--file",
                "../example/label.dot",
                "scg_type",
                "priority"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}